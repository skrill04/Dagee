// --- 1. SALES DATA ---
function getDashboardData(sheetName) {
  try {
    const ss = SpreadsheetApp.getActiveSpreadsheet();
    if (!sheetName) sheetName = "CONTAINER RECORDS 2026";
    
    const sheets = ss.getSheets();
    let sheet = sheets.find(s => s.getName().trim().toUpperCase() === sheetName.trim().toUpperCase());
    if (!sheet) {
      sheet = sheets.find(s => s.getName().toUpperCase().startsWith("CONTAINER RECORDS"));
    }

    if (!sheet) return [];

    const lastRow = sheet.getLastRow();
    if (lastRow < 2) return [];

    const range = sheet.getRange(2, 1, lastRow - 1, 31); 
    const data = range.getValues();
    let cleanData = [];

    data.forEach(row => {
      let entryDate = row[0];
      let containerNo = row[1];
      
      if (containerNo && String(containerNo).trim().length > 3) {
        const cNo = String(containerNo).toUpperCase();
        const keywordsToSkip = ["AGENT", "PAYMENT", "NOTE", "STATUS", "TOTAL", "CONTAINER", "SUM", "BALANCE"];
        
        if (!keywordsToSkip.some(w => cNo.includes(w))) {
           let finalDateStr = "2026-01-01";
           let timestamp = 0;
           let dateVal = entryDate;
           if (typeof dateVal === 'string') dateVal = dateVal.replace(/,/g, '');
           try {
             let d = new Date(dateVal);
             if (!isNaN(d.getTime())) {
               finalDateStr = Utilities.formatDate(d, "GMT", "yyyy-MM-dd");
               timestamp = d.getTime();
             }
           } catch(e) {}

           let productCost = cleanMoney(row[13]);
           let sheetTotalAmount = cleanMoney(row[27]);
           
           let duty = cleanMoney(row[14]);        
           let demurrage = cleanMoney(row[15]);   
           let shipLine = cleanMoney(row[16]);    
           let gpha = cleanMoney(row[17]);        
           let transport = cleanMoney(row[18]);   
           let fda = cleanMoney(row[19]);         
           let agent = cleanMoney(row[20]);       
           let storage = cleanMoney(row[24]);     
           let discharging = cleanMoney(row[25]); 

           let manualSum = duty + demurrage + shipLine + gpha + transport + fda + agent + storage + discharging;

           let finalLogistics = 0;
           if (sheetTotalAmount > productCost && productCost > 0) {
              finalLogistics = sheetTotalAmount - productCost;
           } else if (sheetTotalAmount > 0) {
              finalLogistics = sheetTotalAmount;
           } else {
              finalLogistics = manualSum;
           }

           cleanData.push({
             date: finalDateStr,
             timestamp: timestamp, 
             containerNo: String(row[1]), 
             billOfLading: String(row[2] || "-"), 
             shippingLine: String(row[3] || "-"), 
             shipper: String(row[4] || "-"),         
             port: String(row[5] || "-"),
             product: String(row[6] || "-"), 
             
             quantity: cleanMoney(row[8]),
             unitPrice: cleanMoney(row[9]),
             totalSales: cleanMoney(row[10]),
             costUSD: cleanMoney(row[11]),
             rate: cleanMoney(row[12]),
             productCostGHS: productCost, 
             
             duty: duty, demurrage: demurrage, shipLinePay: shipLine,
             gpha: gpha, transport: transport, fda: fda,
             agent: agent, storage: storage, discharging: discharging,
             
             totalAmount: finalLogistics
           });
        }
      }
    });
    
    cleanData.sort((a, b) => b.timestamp - a.timestamp);
    return cleanData;
  } catch (err) {
    return []; 
  }
}

// --- 2. INCOMING DATA (MAPPED TO INCOMING 2026 SHEET STRUCTURE) ---
function getIncomingData() {
  try {
    const ss = SpreadsheetApp.getActiveSpreadsheet();
    const sheets = ss.getSheets();
    
    let sheet = sheets.find(s => s.getName().toUpperCase().trim().includes("INCOMING"));

    if (!sheet) return [];

    const lastRow = sheet.getLastRow();
    if (lastRow < 3) return [];

    // Fetch starting at Row 3 across 10 Columns (A to J)
    const range = sheet.getRange(3, 1, lastRow - 2, 10); 
    const data = range.getValues();
    let incomingList = [];

    for (let i = 0; i < data.length; i++) {
      let row = data[i];
      
      let containerNo = String(row[2] || "").trim(); // Col C
      let blNo = String(row[0] || "-").trim();       // Col A

      if (!containerNo || containerNo.length < 3 || containerNo.toUpperCase().includes("CONTAINER")) {
        continue;
      }

      try {
        let etaStr = "TBD"; 
        let daysLeft = 999;
        let dateVal = row[3]; // Col D (ETA)

        if (dateVal) {
           let d = (dateVal instanceof Date) ? dateVal : new Date(String(dateVal).replace(/,/g, ''));
           if (!isNaN(d.getTime())) {
             etaStr = Utilities.formatDate(d, "GMT", "MMM dd, yyyy");
             let now = new Date();
             let diff = d.getTime() - now.getTime();
             daysLeft = Math.ceil(diff / (1000 * 60 * 60 * 24));
           }
        }

        let arrivedVal = String(row[8] || "").toUpperCase().trim(); // Col I
        let clearedVal = String(row[9] || "").toUpperCase().trim(); // Col J

        let isArrived = (arrivedVal.includes("YES") || arrivedVal.includes("Y") || arrivedVal === "TRUE");
        let isCleared = (clearedVal.includes("YES") || clearedVal.includes("Y") || clearedVal === "TRUE");

        incomingList.push({
          blNo: blNo, 
          containerNo: containerNo, 
          eta: etaStr, 
          daysLeft: daysLeft,
          product: String(row[4] || "-"),     // Col E
          brand: String(row[5] || "-"),       // Col F
          country: String(row[6] || "-"),     // Col G
          shippingLine: String(row[7] || "-"),// Col H
          arrived: isArrived, 
          cleared: isCleared
        });
      } catch (e) {
        Logger.log("Error processing row " + i + ": " + e.toString());
      }
    }

    incomingList.sort((a, b) => a.daysLeft - b.daysLeft);
    return incomingList;

  } catch (err) { 
    return []; 
  }
}

// --- 3. PAYROLL DATA ---
function getPayrollData() {
  try {
    const ss = SpreadsheetApp.getActiveSpreadsheet();
    const sheet = ss.getSheets().find(s => s.getName().toUpperCase().includes("SALARY"));
    if (!sheet) return [];

    const lastRow = sheet.getLastRow();
    if (lastRow < 2) return [];

    const range = sheet.getRange(2, 1, lastRow - 1, 11); 
    const data = range.getValues();
    let payrollList = [];
    
    data.forEach(row => {
      let name = String(row[0] || "").trim();
      if (name !== "" && !name.toUpperCase().includes("NAME") && !name.toUpperCase().includes("EMPLOYEE")) {
         let periodStr = String(row[4] || "");
         let monthIndex = -1;

         if (row[4] instanceof Date) {
            periodStr = Utilities.formatDate(row[4], "GMT", "MMM yyyy");
            monthIndex = row[4].getMonth();
         } else if (row[4]) {
            let d = new Date(row[4]);
            if (!isNaN(d.getTime())) {
              monthIndex = d.getMonth();
            }
         }

         payrollList.push({
           name: String(row[0] || "-"), 
           role: String(row[1] || "-"), 
           dept: String(row[2] || "-"), 
           method: String(row[3] || "-"), 
           period: periodStr, 
           monthIndex: monthIndex,
           basic: cleanMoney(row[5]), 
           containers: cleanMoney(row[6]), 
           commRate: cleanMoney(row[7]),
           deductions: cleanMoney(row[8]), 
           netPay: cleanMoney(row[9]), 
           status: String(row[10] || "-")
         });
      }
    });
    return payrollList;
  } catch(err) { 
    return []; 
  }
}

// --- 4. INDIVIDUAL CONTAINER CUSTOMER SALES TAB READER (PRECISE EXCEL MAP) ---
function getContainerSalesDetails(containerNo) {
  try {
    const ss = SpreadsheetApp.getActiveSpreadsheet();
    const sheets = ss.getSheets();
    
    const rawContainer = String(containerNo || "").replace(/[^a-zA-Z0-9]/g, "").toUpperCase();

    if (!rawContainer || rawContainer.length < 4) return { found: false };

    // Search tab name for container code
    let sheet = sheets.find(s => {
      let cleanTabName = s.getName().replace(/[^a-zA-Z0-9]/g, "").toUpperCase();
      return cleanTabName.includes(rawContainer);
    });

    if (!sheet) return { found: false };

    // Exact Excel Cell Map
    let totalQty = cleanMoney(sheet.getRange("C3").getValue());     // Cell C3
    let qtyLeft = cleanMoney(sheet.getRange("C4").getValue());      // Cell C4
    let boxesSold = cleanMoney(sheet.getRange("F3").getValue());    // Cell F3
    let totalMoneyIn = cleanMoney(sheet.getRange("F4").getValue()); // Cell F4
    
    let h3Label = String(sheet.getRange("H3").getValue() || "").toUpperCase();
    let shortage = h3Label.includes("SHORTAGE") ? cleanMoney(sheet.getRange("H4").getValue()) : 0;
    let status = String(sheet.getRange("H2").getValue() || "IN PROGRESS").trim();

    // Sales Transactions Start on Row 6
    const lastRow = sheet.getLastRow();
    let salesTransactions = [];

    if (lastRow >= 6) {
      const range = sheet.getRange(6, 1, lastRow - 5, 7); // Row 6 onwards, Cols A-G
      const data = range.getValues();

      data.forEach(row => {
        let dateVal = row[0];
        let customer = String(row[1] || "").trim();
        let itemNum = String(row[2] || "").trim();
        let qty = cleanMoney(row[3]);       // Col D
        let price = cleanMoney(row[4]);     // Col E
        let total = cleanMoney(row[5]);     // Col F
        let notes = String(row[6] || "").trim(); // Col G

        if (qty > 0 || total > 0 || (customer !== "" && !customer.toUpperCase().includes("CUSTOMER"))) {
          let dateStr = "-";
          if (dateVal instanceof Date && !isNaN(dateVal.getTime())) {
            dateStr = Utilities.formatDate(dateVal, "GMT", "yyyy-MM-dd");
          } else if (dateVal) {
            dateStr = String(dateVal).split("T")[0];
          }

          salesTransactions.push({
            date: dateStr,
            customer: customer || "Walk-in Buyer",
            item: itemNum || "-",
            quantity: qty,
            pricePerCarton: price,
            totalAmount: total,
            notes: notes || "-"
          });
        }
      });
    }

    return {
      found: true,
      totalQty: totalQty,
      boxesSold: boxesSold,
      qtyLeft: qtyLeft,
      totalMoneyIn: totalMoneyIn,
      shortage: shortage,
      status: status,
      transactions: salesTransactions
    };
  } catch (err) {
    return { found: false, error: err.toString() };
  }
}

function getAvailableSheets() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  return ss.getSheets().map(s => s.getName()).filter(n => n.toUpperCase().startsWith("CONTAINER RECORDS")).sort().reverse();
}

// SANITIZE NUMBERS & CURRENCIES
function cleanMoney(raw) {
  if (raw === null || raw === undefined || raw === "") return 0;
  if (typeof raw === 'number') return isNaN(raw) ? 0 : raw;
  if (typeof raw === 'boolean') return 0;

  let str = String(raw).trim();

  if (str.startsWith('#')) return 0;

  str = str.replace(/GHS|₵|\$|,|\s/g, '');

  if (str.indexOf('(') !== -1 && str.indexOf(')') !== -1) {
    str = '-' + str.replace(/[\(\)]/g, '');
  }

  let val = parseFloat(str);
  return isNaN(val) ? 0 : val;
}
